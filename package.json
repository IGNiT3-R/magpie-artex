{
  "name": "magpie-agent-artex",
  "version": "0.9.0",
  "description": "Add ARTEX as a native Magpie agent and make Magpie models available in ARTEX's own model pickers.",
  "author": "IGNiT3-R",
  "homepage": "https://github.com/IGNiT3-R/magpie-artex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IGNiT3-R/magpie-artex.git"
  },
  "bugs": {
    "url": "https://github.com/IGNiT3-R/magpie-artex/issues"
  },
  "type": "module",
  "main": "./index.mjs",
  "bin": {
    "magpie-artex": "./bin/magpie-artex.mjs"
  },
  "files": [
    "artex.agent.js",
    "index.mjs",
    "bin/",
    "lib/",
    "page/",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "setup": "node ./bin/magpie-artex.mjs setup",
    "status": "node ./bin/magpie-artex.mjs status",
    "sync": "node ./bin/magpie-artex.mjs sync",
    "watch": "node ./bin/magpie-artex.mjs watch",
    "disconnect": "node ./bin/magpie-artex.mjs disconnect",
    "instances": "node ./bin/magpie-artex.mjs instances",
    "wsl": "node ./bin/magpie-artex.mjs wsl",
    "doctor": "node ./bin/magpie-artex.mjs doctor",
    "test": "node --test test/*.test.mjs",
    "test:magpie": "node ./scripts/verify-magpie-host.mjs",
    "test:agent": "node ./scripts/verify-magpie-agent.mjs",
    "check:public": "node ./scripts/check-public.mjs",
    "check:package": "node ./scripts/check-public.mjs --package",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": ["magpie", "magpie-agent", "artex", "llm-gateway"],
  "license": "MIT",
  "magpie": {
    "agent": "./artex.agent.js",
    "panels": [
      { "slot": "settings", "title": "ARTEX connections", "titles": { "zh": "ARTEX 连接设置", "zh-TW": "ARTEX 連線設定" }, "file": "page/agents.html" }
    ]
  }
}
