+package gui
+
+import (
+	"encoding/json"
+	"github.com/yetone/magpie/internal/agentplug"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestAgentPanelListsItsNativeAgentID(t *testing.T) {
+	on, _, _, _ := panelPlugins(t)
+	pkg := `{"name":"artex-details","magpie":{"panels":[{"slot":"agent","agent":"artex","title":"Connection","file":"ui/notes.html"}]}}`
+	if err := os.WriteFile(filepath.Join(on, "package.json"), []byte(pkg), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	w := do(pageMux(), httptest.NewRequest("GET", "/api/plugin-panels", nil))
+	var panels []pluginPanel
+	if err := json.Unmarshal(w.Body.Bytes(), &panels); err != nil || len(panels) != 1 {
+		t.Fatalf("panels: %s %v", w.Body, err)
+	}
+	if panels[0].Agent != "artex" || panels[0].Slot != "agent" {
+		t.Fatalf("native detail target lost: %+v", panels[0])
+	}
+}
+
+func TestAgentPanelFollowsClientsFromTheSamePlugin(t *testing.T) {
+	on, _, _, _ := panelPlugins(t)
+	inventory := filepath.Join(t.TempDir(), "clients.json")
+	os.WriteFile(inventory, []byte(`{"version":1,"instances":[{"id":"artex-wsl-example","name":"ARTEX WSL Example","config":"~/.artex-wsl.json"}]}`), 0o600)
+	pkg, _ := json.Marshal(map[string]any{"name": "artex-details", "magpie": map[string]any{"agent": "agent.js", "agentInstances": inventory, "panels": []any{map[string]any{"slot": "agent", "agent": "artex", "file": "ui/notes.html"}}}})
+	os.WriteFile(filepath.Join(on, "package.json"), pkg, 0o600)
+	os.WriteFile(filepath.Join(on, "agent.js"), []byte(`export const agent={id:"artex",config:"~/.artex.json",model:"model"};`), 0o600)
+	agentplug.Reload()
+	t.Cleanup(agentplug.Reload)
+	w := do(pageMux(), httptest.NewRequest("GET", "/api/plugin-panels", nil))
+	var panels []pluginPanel
+	if err := json.Unmarshal(w.Body.Bytes(), &panels); err != nil || len(panels) != 2 {
+		t.Fatalf("one plugin's client Details: %s %v", w.Body, err)
+	}
+	if panels[0].Agent != "artex" || panels[1].Agent != "artex-wsl-example" || panels[0].Spec != panels[1].Spec || panels[0].Key == panels[1].Key {
+		t.Fatalf("client panel targets: %+v", panels)
+	}
+}
