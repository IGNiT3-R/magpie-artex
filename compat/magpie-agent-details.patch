diff --git a/internal/agent/plugged_instances.go b/internal/agent/plugged_instances.go
new file mode 100644
index 0000000..77b633d
--- /dev/null
+++ b/internal/agent/plugged_instances.go
@@ -0,0 +1,113 @@
+package agent
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/yetone/magpie/internal/agentplug"
+	"github.com/yetone/magpie/internal/plugin"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+// inheritPluginInstance adopts a copied shared bridge once. The marker is
+// separate from its wiring stash, so disconnecting cannot import it again.
+func inheritPluginInstance(home string, p *agentplug.Agent, f pluggedFile, key string) error {
+	if !p.Inherit {
+		return nil
+	}
+	marker := "plugin-instance:" + p.Desc.ID + ":" + f.path
+	stashMu.Lock()
+	defer stashMu.Unlock()
+	m := stashLoad()
+	if m[marker] != "" {
+		return nil
+	}
+	if err := settings.CopyAgentVisibility(p.BaseID, p.Desc.ID); err != nil {
+		return err
+	}
+	baseKey := "plugin:" + p.BaseID + ":" + pluggedPath(home, p.BaseConfig)
+	var old pluggedStash
+	if m[key] == "" && json.Unmarshal([]byte(m[baseKey]), &old) == nil && old.Spec == p.Spec && f.wired(p.Desc.ID, old) {
+		model, _ := f.get(p.Desc.Model)
+		if model == p.Desc.Prefix+old.Ref {
+			for k := range old.Had {
+				old.Had[k] = "\x00"
+			}
+			b, _ := json.Marshal(old)
+			m[key] = string(b)
+			// The copied bridge belongs to Magpie, rather than a provider a
+			// user named magpie by hand. Its own pre-connection file was empty.
+			m[p.Desc.ID+".connect.was"] = "{}"
+		}
+	}
+	m[marker] = p.BaseID
+	return stashWrite(m)
+}
+
+// A client's bridge is nested below the inventory, which copyTop doesn't
+// include. Give the dry run its own inventory, with every absolute home path
+// relocated. Its shared plugin package and the real bridges stay read-only.
+func copyPluginInventoryForPreview(a *Agent, home, tmp string) error {
+	if a.Plugin == "" {
+		return nil
+	}
+	raw := plugin.AgentInstances(plugin.Target(a.Plugin))
+	if raw == "" {
+		return nil
+	}
+	if !strings.HasPrefix(raw, "~/") && !strings.Contains(raw, "$HOME") {
+		return errors.New("no preview for a plugin with an absolute agent inventory")
+	}
+	file := pluggedPath(home, raw)
+	rel, err := filepath.Rel(home, file)
+	if err != nil || strings.HasPrefix(rel, "..") {
+		return errors.New("the agent inventory is outside home")
+	}
+	b, err := os.ReadFile(file)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	var data map[string]json.RawMessage
+	if err := json.Unmarshal(b, &data); err != nil {
+		return err
+	}
+	var rows []map[string]json.RawMessage
+	if err := json.Unmarshal(data["instances"], &rows); err != nil {
+		return err
+	}
+	for _, row := range rows {
+		for _, key := range []string{"config", "dir"} {
+			var value string
+			if len(row[key]) == 0 {
+				continue
+			}
+			if err := json.Unmarshal(row[key], &value); err != nil {
+				return err
+			}
+			if !filepath.IsAbs(value) {
+				continue
+			}
+			moved := movedKey(value, home, tmp)
+			if moved == value {
+				return errors.New("the agent inventory contains a path outside home")
+			}
+			row[key], _ = json.Marshal(moved)
+		}
+	}
+	data["instances"], _ = json.Marshal(rows)
+	b, err = json.Marshal(data)
+	if err != nil {
+		return err
+	}
+	dest := filepath.Join(tmp, rel)
+	if err := os.MkdirAll(filepath.Dir(dest), 0o700); err != nil {
+		return err
+	}
+	return os.WriteFile(dest, b, 0o600)
+}
