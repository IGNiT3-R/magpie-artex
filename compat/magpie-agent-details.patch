@@ -0,0 +1,31 @@
+package settings
+
+import "slices"
+
+// CopyAgentVisibility seeds a newly split client from its old shared row.
+// Existing client choices, including an explicitly empty picked list, win.
+// The caller journals that this one-time import has completed.
+func CopyAgentVisibility(from, to string) error {
+	defer lockFile()()
+	s, err := loadChecked()
+	if err != nil {
+		return err
+	}
+	changed := false
+	for _, m := range []map[string][]string{s.Visible, s.HiddenModels, s.PickedModels, s.OrderedModels} {
+		if value, ok := m[from]; ok {
+			if _, exists := m[to]; !exists {
+				m[to] = append([]string{}, value...)
+				changed = true
+			}
+		}
+	}
+	if slices.Contains(s.OwnModelsHidden, from) && !slices.Contains(s.OwnModelsHidden, to) {
+		s.OwnModelsHidden = append(s.OwnModelsHidden, to)
+		changed = true
+	}
+	if !changed {
+		return nil
+	}
+	return save(s, false)
+}
