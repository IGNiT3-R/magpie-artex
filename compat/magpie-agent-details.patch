+package agentplug
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestInstanceInventoryReusesHooksWithSeparateIdentity(t *testing.T) {
+	dir := t.TempDir()
+	file, inventory := filepath.Join(dir, "agent.js"), filepath.Join(dir, "clients.json")
+	os.WriteFile(file, []byte(`export const agent={id:"clients",config:"~/.clients/main.json",model:"model"};
+export function connect({agent}) { return {identity:agent.id, location:agent.config}; }`), 0o600)
+	os.WriteFile(inventory, []byte(`{"version":1,"includeBase":false,"instances":[{"id":"clients-wsl","name":"Client WSL","config":"~/.clients/wsl.json","dir":"~/.clients"}]}`), 0o600)
+	list, err := compileInstances(dir, file, inventory)
+	if err != nil || len(list) != 1 {
+		t.Fatalf("clients: %v %v", list, err)
+	}
+	a := list[0]
+	if a.BaseID != "clients" || a.Spec != dir || a.Desc.Name != "Client WSL" {
+		t.Fatalf("client metadata: %+v", a)
+	}
+	result, err := a.Connect(map[string]any{"agent": map[string]any{"id": a.Desc.ID, "config": a.Desc.Config}})
+	if err != nil || result["identity"] != "clients-wsl" || result["location"] != instancePath("~/.clients/wsl.json") {
+		t.Fatalf("client hook: %v %v", result, err)
+	}
+}
+
+func TestInstanceInventoryRejectsAmbiguousAndBrokenClients(t *testing.T) {
+	dir := t.TempDir()
+	file, inventory := filepath.Join(dir, "agent.js"), filepath.Join(dir, "clients.json")
+	os.WriteFile(file, []byte(`export const agent={id:"clients",config:"~/.clients.json",model:"model"};`), 0o600)
+	for _, data := range []string{
+		`{"version":1,"instances":[{"id":"clients","config":"~/.other.json"}]}`,
+		`{"version":1,"instances":[{"id":"child","config":"~/.clients.json"}]}`,
+		`{"version":1,"instances":[{"id":"INVALID","config":"~/.other.json"}]}`,
+		`{"version":2,"instances":[]}`,
+		`{`,
+	} {
+		os.WriteFile(inventory, []byte(data), 0o600)
+		if _, err := compileInstances(dir, file, inventory); err == nil {
+			t.Fatalf("accepted ambiguous inventory %s", data)
+		}
+	}
+}
