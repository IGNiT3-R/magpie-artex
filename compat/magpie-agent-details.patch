+// A failed panel recovers in its own place; the page around it goes on.
+export function showError(body, name, why, retry) {
+  const card = el("div", "plugin-panel-broke");
+  card.setAttribute("role", "alert");
+  card.append(el("b", "", t("{name} stopped working", { name })), el("span", "note", why));
+  const again = el("button", "text", t("Try again"));
+  again.type = "button";
+  again.onclick = retry;
+  card.append(again);
+  body.replaceChildren(card);
+}
