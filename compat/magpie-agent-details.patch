index 0000000..a60a559
--- /dev/null
+++ b/internal/agentplug/instances.go
@@ -0,0 +1,105 @@
+package agentplug
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// instanceInventory contains public locations only, never client credentials.
+// An instance inherits its module's hooks, format and model keys; only its
+// identity and local bridge location differ. It is not an installed plugin.
+type instanceInventory struct {
+	Version     int    `json:"version"`
+	IncludeBase *bool  `json:"includeBase"`
+	BaseName    string `json:"baseName"`
+	Instances   []struct {
+		ID      string `json:"id"`
+		Name    string `json:"name"`
+		Config  string `json:"config"`
+		Dir     string `json:"dir"`
+		Inherit bool   `json:"inherit"`
+	} `json:"instances"`
+}
+
+func instancePath(p string) string {
+	if p == "" {
+		return ""
+	}
+	home, _ := os.UserHomeDir()
+	p = os.Expand(p, func(k string) string {
+		if k == "HOME" {
+			return home
+		}
+		return os.Getenv(k)
+	})
+	if p == "~" || strings.HasPrefix(p, "~/") {
+		p = filepath.Join(home, p[1:])
+	}
+	return filepath.Clean(p)
+}
+
+func compileInstances(spec, file, inventory string) ([]*Agent, error) {
+	base, err := Compile(spec, file)
+	if err != nil {
+		return nil, err
+	}
+	base.BaseID, base.BaseConfig = base.Desc.ID, base.Desc.Config
+	if inventory == "" {
+		return []*Agent{base}, nil
+	}
+	b, err := os.ReadFile(inventory)
+	if errors.Is(err, os.ErrNotExist) {
+		return []*Agent{base}, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("agent instances: %w", err)
+	}
+	var in instanceInventory
+	if len(b) > 256*1024 || json.Unmarshal(b, &in) != nil || in.Version != 1 || len(in.Instances) > 128 {
+		return nil, errors.New("agent instances: expected a version 1 inventory with at most 128 clients")
+	}
+	if in.BaseName != "" {
+		base.Desc.Name = in.BaseName
+	}
+	var out []*Agent
+	if in.IncludeBase == nil || *in.IncludeBase {
+		out = append(out, base)
+	}
+	ids := map[string]bool{base.Desc.ID: true}
+	paths := map[string]bool{instancePath(base.Desc.Config): true}
+	for _, row := range in.Instances {
+		resolve := func(value string) string {
+			if value == "" {
+				return ""
+			}
+			expanded := instancePath(value)
+			if !filepath.IsAbs(expanded) {
+				return filepath.Join(filepath.Dir(inventory), expanded)
+			}
+			return expanded
+		}
+		config, dir := resolve(row.Config), resolve(row.Dir)
+		if ids[row.ID] || paths[config] || strings.TrimSpace(row.Config) == "" {
+			return nil, fmt.Errorf("agent instances: duplicate id or config for %q", row.ID)
+		}
+		child, err := Compile(spec, file)
+		if err != nil {
+			return nil, err
+		}
+		child.BaseID, child.BaseConfig, child.Inherit = base.Desc.ID, base.Desc.Config, row.Inherit
+		child.Desc.ID, child.Desc.Name, child.Desc.Config, child.Desc.Dir = row.ID, row.Name, config, dir
+		if err := child.Desc.check(); err != nil {
+			return nil, fmt.Errorf("agent instance: %w", err)
+		}
+		if child.Desc.Startup != nil || child.Desc.Library != (Places{}) {
+			return nil, errors.New("agent instances: separate startup or library paths are not supported")
+		}
+		ids[row.ID], paths[config] = true, true
+		out = append(out, child)
+	}
+	return out, nil
+}
