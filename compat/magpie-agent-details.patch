+package agent
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/yetone/magpie/internal/agentplug"
+	"github.com/yetone/magpie/internal/edit"
+	"github.com/yetone/magpie/internal/gateway"
+	"github.com/yetone/magpie/internal/settings"
+)
+
+func TestPluginInstancesInheritOnceAndDisconnectIndependently(t *testing.T) {
+	home := pluggedHome(t, `export const agent={id:"clients",name:"Clients",dir:"~/",config:"~/.clients.json",model:"model"};
+export function connect({gateway,models}) { return {api_key:gateway.key,base_url:gateway.v1,models}; }`)
+	base, err := Find("clients")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := settings.Save(settings.Settings{PickedModels: map[string][]string{"clients": {"deepseek/pro"}}}); err != nil {
+		t.Fatal(err)
+	}
+	if err := base.Pick("model", "magpie/deepseek/pro"); err != nil {
+		t.Fatal(err)
+	}
+	basePath, childPath := filepath.Join(home, ".clients.json"), filepath.Join(home, ".clients-wsl.json")
+	b, _ := os.ReadFile(basePath)
+	if err := os.WriteFile(childPath, b, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	inventory := filepath.Join(home, "clients-inventory.json")
+	writeInventory := func(include bool) {
+		t.Helper()
+		data, _ := json.Marshal(map[string]any{"version": 1, "includeBase": include, "instances": []any{map[string]any{"id": "clients-wsl", "name": "Clients WSL", "config": childPath, "dir": home, "inherit": true}}})
+		if err := os.WriteFile(inventory, data, 0o600); err != nil {
+			t.Fatal(err)
+		}
+		agentplug.Reload()
+	}
+	pkg, _ := json.Marshal(map[string]any{"name": "pa", "magpie": map[string]any{"agent": "./agent.js", "agentInstances": inventory}})
+	if err := os.WriteFile(filepath.Join(home, "plugins", "pa", "package.json"), pkg, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	writeInventory(false)
+	child, err := Find("clients-wsl")
+	if err != nil {
+		t.Fatalf("one installed plugin did not expose its WSL client: %v", err)
+	}
+	if !child.Wired() || child.Field("model").Get() != "magpie/deepseek/pro" {
+		t.Fatalf("existing shared connection was lost during client migration: wired=%v model=%q base=%v child=%v", child.Wired(), child.Field("model").Get(), base.Wired(), len(stashLoad()))
+	}
+	if got := settings.Load().PickedModels["clients-wsl"]; len(got) != 1 || got[0] != "deepseek/pro" {
+		t.Fatalf("visible models were reset: %v", got)
+	}
+	if err := child.Sync(); err != nil {
+		t.Fatal(err)
+	}
+	if key, _ := edit.GetJSON(childPath, "api_key"); key != gateway.TokenFor("clients-wsl") {
+		t.Fatal("WSL client did not get its own gateway identity")
+	}
+	if key, _ := edit.GetJSON(basePath, "api_key"); key != gateway.TokenFor("clients") {
+		t.Fatal("WSL sync changed the local client")
+	}
+	if err := child.Disconnect(); err != nil {
+		t.Fatal(err)
+	}
+	child, err = Find("clients-wsl")
+	if err != nil || child.Wired() {
+		t.Fatal("disconnect imported the shared connection again")
+	}
+	if !base.Wired() {
+		t.Fatal("disconnecting WSL disconnected the local client")
+	}
+	writeInventory(true)
+	child, err = Find("clients-wsl")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := child.Pick("model", "magpie/deepseek/pro"); err != nil {
+		t.Fatal(err)
+	}
+	if err := UnwirePlugin(base.Plugin); err != nil {
+		t.Fatal(err)
+	}
+	if base.Wired() || child.Wired() {
+		t.Fatal("removing the one plugin left one of its clients wired")
+	}
+}
+
+func TestPluginInstancePreviewUsesOnlyCopiedFiles(t *testing.T) {
+	home := pluggedHome(t, `export const agent={id:"clients",config:"~/.clients/main.json",model:"model"};
+export function connect({gateway}) { return {api_key:gateway.key}; }`)
+	file := filepath.Join(home, ".clients", "instances", "wsl", "agent.json")
+	os.MkdirAll(filepath.Dir(file), 0o700)
+	os.WriteFile(file, []byte(`{"keep":true}`), 0o600)
+	inventory := filepath.Join(home, ".clients", "agents.json")
+	os.WriteFile(inventory, []byte(`{"version":1,"includeBase":false,"instances":[{"id":"clients-wsl","config":"instances/wsl/agent.json","dir":"instances/wsl"}]}`), 0o600)
+	os.WriteFile(filepath.Join(home, "plugins", "pa", "package.json"), []byte(`{"name":"pa","magpie":{"agent":"./agent.js","agentInstances":"~/.clients/agents.json"}}`), 0o600)
+	agentplug.Reload()
+	a, err := Find("clients-wsl")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := a.Pick("model", "magpie/deepseek/pro"); err != nil {
+		t.Fatal(err)
+	}
+	before, _ := os.ReadFile(file)
+	tmp := t.TempDir()
+	rel, _ := filepath.Rel(home, filepath.Dir(file))
+	if err := copyTop(filepath.Dir(file), filepath.Join(tmp, rel), nil, false); err != nil {
+		t.Fatal(err)
+	}
+	cfgRel, _ := filepath.Rel(home, settings.Dir())
+	if err := copyTop(settings.Dir(), filepath.Join(tmp, cfgRel), nil, true); err != nil {
+		t.Fatal(err)
+	}
+	if err := copyPluginInventoryForPreview(a, home, tmp); err != nil {
+		t.Fatal(err)
+	}
+	stashRel, _ := filepath.Rel(home, stashPath())
+	if err := moveStashKeys(filepath.Join(tmp, stashRel), home, tmp); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("HOME", tmp)
+	t.Setenv("USERPROFILE", tmp)
+	t.Setenv("XDG_CONFIG_HOME", filepath.Join(tmp, ".config"))
+	agentplug.Reload()
+	preview, err := Find("clients-wsl")
+	if err != nil {
+		t.Fatalf("the copied inventory lost the native client: %v", err)
+	}
+	if preview.Path == file || !preview.Wired() {
+		t.Fatal("disconnect preview did not use its own connected bridge")
+	}
+	if err := preview.Disconnect(); err != nil {
+		t.Fatal(err)
+	}
+	after, _ := os.ReadFile(file)
+	if string(after) != string(before) {
+		t.Fatal("preview changed the original client")
+	}
+	if model, _ := edit.GetJSON(preview.Path, "model"); model != "" {
+		t.Fatal("preview did not restore its copied client")
+	}
+}
