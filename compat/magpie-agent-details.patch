+// Native Details integration is loaded only when a plugin targets an agent.
+// Refresh its availability without replacing an open, unchanged form.
+let signature = "";
+export function load(panels) {
+  const agents = new Set(panels.filter((p) => p.slot === "agent").map((p) => p.agent));
+  const next = JSON.stringify([...agents].sort());
+  magpie.hasAgentPanel = (id) => agents.has(id);
+  magpie.agentSettings = (agent, kv) => {
+    if (agents.has(agent.id)) kv(t("Settings"), magpie.slot("agent", { agent: { id: agent.id, name: agent.name } }));
+  };
+  if (signature === next) return;
+  signature = next;
+  if (view === "agents" && typeof renderAgents === "function") renderAgents();
+}
